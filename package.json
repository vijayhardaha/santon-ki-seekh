{
  "name": "santon-ki-seekh",
  "version": "1.0.10",
  "description": "यह संग्रह आध्यात्मिक शिक्षाओं का एक चयन है, जिसमें संत कबीर के भजन और दोहे, महत्वपूर्ण उद्धरण, और आध्यात्मिकता से संबंधित प्रमुख शब्दों और विषयों की परिभाषाएँ शामिल हैं।",
  "scripts": {
    "clean": "rm -rf docs/dohe dist",
    "clean:docs": "rm -rf docs/dohe",
    "format:docs": "prettier --write 'docs/**/*.md' --log-level error",
    "build": "bun run src/build.ts",
    "build:docs": "bun run src/buildDocs.ts",
    "build:assets": "bun run src/buildAssets.ts",
    "build:test": "bun run src/build.ts --limit 1",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check --log-level error .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "type": "module",
  "author": "Vijay Hardaha",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vijayhardaha/dev-config": "^2.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "json-2-csv": "^5.5.11",
    "ora": "^9.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
